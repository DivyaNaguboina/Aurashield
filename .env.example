# AuraShield environment configuration
# Copy this file to `.env` and fill in your own key. NEVER commit `.env`.
#
# Free key (no credit card): https://openrouter.ai/keys
#
# WARNING: Vite inlines every VITE_* variable into the client-side JavaScript
# bundle. This is fine for local development, but do NOT deploy a production
# build that was compiled with a real key in .env: anyone can read it from the
# browser. For a public deployment, proxy the OpenRouter calls through a
# server/serverless function that holds the key.
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
